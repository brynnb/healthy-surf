{
  "name": "@extension/dev-utils",
  "version": "0.2.2",
  "description": "chrome extension dev utils",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "index.ts",
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./build",
    "ready": "tsc",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --write --ignore-path ../../.prettierignore",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "setup-db": "ts-node lib/database-manager/setupDatabase.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.0.0",
    "jsdom": "^24.0.0",
    "node-fetch": "^3.3.0",
    "openai": "^4.0.0",
    "sqlite3": "^5.0.0"
  },
  "devDependencies": {
    "@extension/tsconfig": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.24",
    "@types/sqlite3": "^3.1.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}